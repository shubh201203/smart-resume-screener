# Database configuration
# Local SQLite default: sqlite:///./resume_screener.db
# Neon PostgreSQL (Production): postgresql://user:password@ep-cool-service.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./resume_screener.db

# Host and Port (Render dynamically assigns PORT)
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated list of origins)
# In production, set this to your Vercel URL and any custom domains
# Example: https://smart-resume-screener.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional: LLM configuration (OpenAI / OpenRouter / compatible endpoint)
# Leave empty to use built-in deterministic TF-IDF and regex fallback engine
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
